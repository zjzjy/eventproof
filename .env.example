# LLM (Alibaba Cloud Bailian / DashScope OpenAI-compatible)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL_FAST=qwen3.8-flash
LLM_MODEL_STRONG=qwen3.8-flash
LLM_MAX_SPEND_CNY=10
LLM_HARD_STOP_CNY=8

# Data
IFIND_TOKEN=
DATA_MODE=hybrid
AI_MODE=precomputed

# App
DEMO_MODE=true
ADMIN_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000
TZ=Asia/Shanghai

# Database: local SQLite by default; deployment uses Neon Postgres
DATABASE_URL=sqlite:///./data/eventproof.db
